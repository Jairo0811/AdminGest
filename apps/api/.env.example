NODE_ENV=development
PORT=3000
DATABASE_URL="sqlserver://localhost:1433;database=AdminGestDb;user=sa;password=CHANGE_ME;trustServerCertificate=true"
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
# Tokens de acceso cortos (máximo 1h). La sesión se mantiene con el refresh token de 7 días.
JWT_EXPIRES_IN=15m
SWAGGER_ENABLED=true
# Proxy inverso HTTPS: false, true, loopback o número de saltos (por ejemplo 1).
TRUST_PROXY=false
# Dominios autorizados para referencias documentales (obligatorio en producción).
DOCUMENT_ALLOWED_HOSTS=
# Seed: contraseña del administrador demo (mínimo 10 caracteres; si se omite se genera una).
SEED_ADMIN_PASSWORD=
# SEED_DEMO_DATA=true|false (por defecto true fuera de producción)
# SEED_SYNC_PLANS=true sobrescribe los límites de los planes existentes
# SEED_RESET_ADMIN_PASSWORD=true restablece la contraseña del admin existente (no permitido en producción)
PASSWORD_RESET_URL=http://localhost:5173/reset-password
RESEND_API_KEY=
MAIL_FROM=AdminGest <no-reply@example.com>
