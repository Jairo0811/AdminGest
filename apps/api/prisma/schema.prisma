generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Company {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  name           String          @db.NVarChar(140)
  taxId          String?         @unique @db.NVarChar(30)
  email          String?         @db.NVarChar(254)
  phone          String?         @db.NVarChar(30)
  address        String?         @db.NVarChar(500)
  logoUrl        String?         @db.NVarChar(500)
  currency       String          @default("DOP") @db.NVarChar(3)
  timezone       String          @default("America/Santo_Domingo") @db.NVarChar(64)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  leads          Lead[]
  customers      Customer[]
  pipelineStages PipelineStage[]
  opportunities  Opportunity[]
  activities     Activity[]
  catalogItems   CatalogItem[]
  quotes         Quote[]
  projects       Project[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model User {
  id                    String         @id @default(uuid()) @db.UniqueIdentifier
  companyId             String         @db.UniqueIdentifier
  email                 String         @unique @db.NVarChar(254)
  passwordHash          String         @db.NVarChar(100)
  firstName             String         @db.NVarChar(60)
  lastName              String         @db.NVarChar(60)
  role                  String         @default("SALES_REP") @db.NVarChar(30)
  status                String         @default("ACTIVE") @db.NVarChar(20)
  lastLoginAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  company               Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedLeads         Lead[]         @relation("LeadOwner")
  assignedOpportunities Opportunity[]  @relation("OpportunityOwner")
  assignedActivities    Activity[]     @relation("ActivityOwner")
  managedProjects       Project[]      @relation("ProjectManager")
  assignedTasks         ProjectTask[]  @relation("TaskAssignee")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([companyId, status])
  @@index([companyId, role])
}

model Lead {
  id          String    @id @default(uuid()) @db.UniqueIdentifier
  companyId   String    @db.UniqueIdentifier
  ownerId     String?   @db.UniqueIdentifier
  firstName   String    @db.NVarChar(80)
  lastName    String?   @db.NVarChar(80)
  companyName String?   @db.NVarChar(140)
  jobTitle    String?   @db.NVarChar(100)
  email       String?   @db.NVarChar(254)
  phone       String?   @db.NVarChar(30)
  source      String?   @db.NVarChar(80)
  status      String    @default("NEW") @db.NVarChar(20)
  priority    Int       @default(2)
  notes       String?   @db.NVarChar(Max)
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner       User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status])
  @@index([ownerId])
}

model Customer {
  id            String        @id @default(uuid()) @db.UniqueIdentifier
  companyId     String        @db.UniqueIdentifier
  name          String        @db.NVarChar(160)
  taxId         String?       @db.NVarChar(30)
  email         String?       @db.NVarChar(254)
  phone         String?       @db.NVarChar(30)
  address       String?       @db.NVarChar(500)
  website       String?       @db.NVarChar(500)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  quotes        Quote[]
  projects      Project[]

  @@index([companyId, name])
  @@index([companyId, isActive])
}

model Contact {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  customerId String   @db.UniqueIdentifier
  firstName  String   @db.NVarChar(80)
  lastName   String?  @db.NVarChar(80)
  jobTitle   String?  @db.NVarChar(100)
  email      String?  @db.NVarChar(254)
  phone      String?  @db.NVarChar(30)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId])
}

model PipelineStage {
  id            String        @id @default(uuid()) @db.UniqueIdentifier
  companyId     String        @db.UniqueIdentifier
  name          String        @db.NVarChar(80)
  position      Int
  probability   Int           @default(0)
  isWon         Boolean       @default(false)
  isLost        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunities Opportunity[]

  @@unique([companyId, position])
  @@index([companyId])
}

model Opportunity {
  id                String        @id @default(uuid()) @db.UniqueIdentifier
  companyId         String        @db.UniqueIdentifier
  customerId        String        @db.UniqueIdentifier
  ownerId           String?       @db.UniqueIdentifier
  pipelineStageId   String        @db.UniqueIdentifier
  name              String        @db.NVarChar(180)
  description       String?       @db.NVarChar(Max)
  estimatedValue    Decimal       @default(0) @db.Decimal(18, 2)
  probability       Int           @default(0)
  expectedCloseDate DateTime?
  status            String        @default("OPEN") @db.NVarChar(20)
  lostReason        String?       @db.NVarChar(500)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner             User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipelineStage     PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activities        Activity[]
  quotes            Quote[]
  project           Project?

  @@index([companyId, status])
  @@index([customerId])
  @@index([ownerId])
  @@index([pipelineStageId])
}

model Activity {
  id            String       @id @default(uuid()) @db.UniqueIdentifier
  companyId     String       @db.UniqueIdentifier
  customerId    String?      @db.UniqueIdentifier
  opportunityId String?      @db.UniqueIdentifier
  ownerId       String?      @db.UniqueIdentifier
  type          String       @db.NVarChar(30)
  status        String       @default("PENDING") @db.NVarChar(20)
  subject       String       @db.NVarChar(180)
  description   String?      @db.NVarChar(Max)
  scheduledAt   DateTime
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner         User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, scheduledAt])
  @@index([ownerId, status])
}

model CatalogItem {
  id             String              @id @default(uuid()) @db.UniqueIdentifier
  companyId      String              @db.UniqueIdentifier
  sku            String?             @db.NVarChar(50)
  name           String              @db.NVarChar(160)
  description    String?             @db.NVarChar(Max)
  type           String              @db.NVarChar(20)
  unitPrice      Decimal             @db.Decimal(18, 2)
  unitCost       Decimal             @default(0) @db.Decimal(18, 2)
  taxRate        Decimal             @default(18) @db.Decimal(5, 2)
  stockQuantity  Decimal             @default(0) @db.Decimal(18, 2)
  reorderPoint   Decimal             @default(0) @db.Decimal(18, 2)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  company        Company             @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quoteItems     QuoteItem[]
  purchaseItems  PurchaseOrderItem[]
  stockMovements InventoryMovement[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
}

model Quote {
  id            String       @id @default(uuid()) @db.UniqueIdentifier
  companyId     String       @db.UniqueIdentifier
  customerId    String       @db.UniqueIdentifier
  opportunityId String?      @db.UniqueIdentifier
  number        String       @db.NVarChar(40)
  status        String       @default("DRAFT") @db.NVarChar(20)
  issueDate     DateTime     @default(now())
  validUntil    DateTime?
  subtotal      Decimal      @default(0) @db.Decimal(18, 2)
  discount      Decimal      @default(0) @db.Decimal(18, 2)
  tax           Decimal      @default(0) @db.Decimal(18, 2)
  total         Decimal      @default(0) @db.Decimal(18, 2)
  notes         String?      @db.NVarChar(Max)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items         QuoteItem[]

  @@unique([companyId, number])
  @@index([customerId, status])
}

model QuoteItem {
  id            String       @id @default(uuid()) @db.UniqueIdentifier
  quoteId       String       @db.UniqueIdentifier
  catalogItemId String?      @db.UniqueIdentifier
  description   String       @db.NVarChar(300)
  quantity      Decimal      @default(1) @db.Decimal(18, 2)
  unitPrice     Decimal      @db.Decimal(18, 2)
  taxRate       Decimal      @default(18) @db.Decimal(5, 2)
  lineTotal     Decimal      @db.Decimal(18, 2)
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([quoteId])
}

model Project {
  id            String        @id @default(uuid()) @db.UniqueIdentifier
  companyId     String        @db.UniqueIdentifier
  customerId    String        @db.UniqueIdentifier
  opportunityId String?       @unique @db.UniqueIdentifier
  managerId     String?       @db.UniqueIdentifier
  name          String        @db.NVarChar(180)
  description   String?       @db.NVarChar(Max)
  status        String        @default("PLANNED") @db.NVarChar(20)
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?      @db.Decimal(18, 2)
  progress      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager       User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks         ProjectTask[]

  @@index([companyId, status])
  @@index([customerId])
}

model ProjectTask {
  id          String        @id @default(uuid()) @db.UniqueIdentifier
  projectId   String        @db.UniqueIdentifier
  assigneeId  String?       @db.UniqueIdentifier
  parentId    String?       @db.UniqueIdentifier
  title       String        @db.NVarChar(200)
  description String?       @db.NVarChar(Max)
  status      String        @default("PENDING") @db.NVarChar(20)
  priority    Int           @default(2)
  startDate   DateTime?
  dueDate     DateTime?
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent      ProjectTask?  @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ProjectTask[] @relation("TaskHierarchy")

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([parentId])
}

model Supplier {
  id             String          @id @default(uuid()) @db.UniqueIdentifier
  companyId      String          @db.UniqueIdentifier
  name           String          @db.NVarChar(160)
  taxId          String?         @db.NVarChar(30)
  email          String?         @db.NVarChar(254)
  phone          String?         @db.NVarChar(30)
  address        String?         @db.NVarChar(500)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrders PurchaseOrder[]

  @@index([companyId, name])
}

model PurchaseOrder {
  id         String              @id @default(uuid()) @db.UniqueIdentifier
  companyId  String              @db.UniqueIdentifier
  supplierId String              @db.UniqueIdentifier
  number     String              @db.NVarChar(40)
  status     String              @default("DRAFT") @db.NVarChar(20)
  orderDate  DateTime            @default(now())
  expectedAt DateTime?
  subtotal   Decimal             @default(0) @db.Decimal(18, 2)
  tax        Decimal             @default(0) @db.Decimal(18, 2)
  total      Decimal             @default(0) @db.Decimal(18, 2)
  notes      String?             @db.NVarChar(Max)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  company    Company             @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items      PurchaseOrderItem[]

  @@unique([companyId, number])
  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.UniqueIdentifier
  purchaseOrderId String        @db.UniqueIdentifier
  catalogItemId   String?       @db.UniqueIdentifier
  description     String        @db.NVarChar(300)
  quantity        Decimal       @default(1) @db.Decimal(18, 2)
  unitCost        Decimal       @db.Decimal(18, 2)
  taxRate         Decimal       @default(18) @db.Decimal(5, 2)
  lineTotal       Decimal       @db.Decimal(18, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogItem     CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([purchaseOrderId])
}

model InventoryMovement {
  id            String      @id @default(uuid()) @db.UniqueIdentifier
  catalogItemId String      @db.UniqueIdentifier
  type          String      @db.NVarChar(20)
  quantity      Decimal     @db.Decimal(18, 2)
  reference     String?     @db.NVarChar(100)
  notes         String?     @db.NVarChar(Max)
  createdAt     DateTime    @default(now())
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([catalogItemId, createdAt])
}

model Expense {
  id          String   @id @default(uuid()) @db.UniqueIdentifier
  companyId   String   @db.UniqueIdentifier
  category    String   @db.NVarChar(80)
  description String   @db.NVarChar(300)
  amount      Decimal  @db.Decimal(18, 2)
  expenseDate DateTime @default(now())
  status      String   @default("REGISTERED") @db.NVarChar(20)
  reference   String?  @db.NVarChar(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, expenseDate])
}

model Notification {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  companyId String    @db.UniqueIdentifier
  userId    String?   @db.UniqueIdentifier
  title     String    @db.NVarChar(180)
  message   String    @db.NVarChar(Max)
  type      String    @default("INFO") @db.NVarChar(20)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User?     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt])
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  companyId String   @db.UniqueIdentifier
  userId    String?  @db.UniqueIdentifier
  action    String   @db.NVarChar(30)
  entity    String   @db.NVarChar(60)
  entityId  String?  @db.UniqueIdentifier
  oldValues String?  @db.NVarChar(Max)
  newValues String?  @db.NVarChar(Max)
  ipAddress String?  @db.NVarChar(45)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt])
  @@index([userId])
}
