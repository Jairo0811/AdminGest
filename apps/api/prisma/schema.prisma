generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_REP
  PROJECT_MANAGER
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  VISIT
  TASK
  FOLLOW_UP
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

model Company {
  id            String         @id @default(uuid())
  name          String
  taxId         String?        @unique
  email         String?
  phone         String?
  address       String?
  logoUrl       String?
  currency      String         @default("DOP")
  timezone      String         @default("America/Santo_Domingo")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  leads         Lead[]
  customers     Customer[]
  opportunities Opportunity[]
  activities    Activity[]
  catalogItems  CatalogItem[]
  quotes        Quote[]
  projects      Project[]
  auditLogs     AuditLog[]
}

model User {
  id                    String        @id @default(uuid())
  companyId             String
  email                 String        @unique
  passwordHash          String
  firstName             String
  lastName              String
  role                   UserRole      @default(SALES_REP)
  status                 UserStatus    @default(ACTIVE)
  lastLoginAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedLeads          Lead[]        @relation("LeadOwner")
  assignedOpportunities Opportunity[] @relation("OpportunityOwner")
  assignedActivities    Activity[]    @relation("ActivityOwner")
  managedProjects       Project[]     @relation("ProjectManager")
  assignedTasks         ProjectTask[] @relation("TaskAssignee")
  auditLogs              AuditLog[]

  @@index([companyId, status])
  @@index([companyId, role])
}

model Lead {
  id          String     @id @default(uuid())
  companyId   String
  ownerId     String?
  firstName   String
  lastName    String?
  companyName String?
  jobTitle    String?
  email       String?
  phone       String?
  source      String?
  status      LeadStatus @default(NEW)
  priority    Int        @default(2)
  notes       String?
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner       User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: NoAction)

  @@index([companyId, status])
  @@index([ownerId])
}

model Customer {
  id            String         @id @default(uuid())
  companyId     String
  name          String
  taxId         String?
  email         String?
  phone         String?
  address       String?
  website       String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  quotes        Quote[]
  projects      Project[]

  @@index([companyId, name])
}

model Contact {
  id         String   @id @default(uuid())
  customerId String
  firstName  String
  lastName   String?
  jobTitle   String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model PipelineStage {
  id            String        @id @default(uuid())
  companyId     String
  name          String
  position      Int
  probability   Int           @default(0)
  isWon         Boolean       @default(false)
  isLost        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@unique([companyId, position])
  @@index([companyId])
}

model Opportunity {
  id                String            @id @default(uuid())
  companyId         String
  customerId        String
  ownerId           String?
  pipelineStageId   String
  name              String
  description       String?
  estimatedValue    Decimal           @default(0) @db.Decimal(18, 2)
  probability       Int               @default(0)
  expectedCloseDate DateTime?
  status            OpportunityStatus @default(OPEN)
  lostReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: NoAction)
  owner             User?             @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: NoAction)
  pipelineStage     PipelineStage     @relation(fields: [pipelineStageId], references: [id], onDelete: NoAction)
  activities        Activity[]
  quotes            Quote[]
  project           Project?

  @@index([companyId, status])
  @@index([customerId])
  @@index([ownerId])
  @@index([pipelineStageId])
}

model Activity {
  id            String         @id @default(uuid())
  companyId     String
  customerId    String?
  opportunityId String?
  ownerId       String?
  type          ActivityType
  status        ActivityStatus @default(PENDING)
  subject       String
  description   String?
  scheduledAt   DateTime
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: NoAction)
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: NoAction)
  owner         User?          @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: NoAction)

  @@index([companyId, scheduledAt])
  @@index([ownerId, status])
}

model CatalogItem {
  id          String      @id @default(uuid())
  companyId   String
  name        String
  description String?
  type        String
  unitPrice   Decimal     @db.Decimal(18, 2)
  taxRate     Decimal     @default(18) @db.Decimal(5, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems  QuoteItem[]

  @@index([companyId, isActive])
}

model Quote {
  id            String      @id @default(uuid())
  companyId     String
  customerId    String
  opportunityId String?
  number        String
  status        QuoteStatus @default(DRAFT)
  issueDate     DateTime    @default(now())
  validUntil    DateTime?
  subtotal      Decimal     @default(0) @db.Decimal(18, 2)
  discount      Decimal     @default(0) @db.Decimal(18, 2)
  tax           Decimal     @default(0) @db.Decimal(18, 2)
  total         Decimal     @default(0) @db.Decimal(18, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: NoAction)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: NoAction)
  items         QuoteItem[]

  @@unique([companyId, number])
  @@index([customerId, status])
}

model QuoteItem {
  id            String      @id @default(uuid())
  quoteId       String
  catalogItemId String?
  description   String
  quantity      Decimal     @default(1) @db.Decimal(18, 2)
  unitPrice     Decimal     @db.Decimal(18, 2)
  taxRate       Decimal     @default(18) @db.Decimal(5, 2)
  lineTotal     Decimal     @db.Decimal(18, 2)
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: NoAction)

  @@index([quoteId])
}

model Project {
  id            String        @id @default(uuid())
  companyId     String
  customerId    String
  opportunityId String?       @unique
  managerId     String?
  name          String
  description   String?
  status        ProjectStatus @default(PLANNED)
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?      @db.Decimal(18, 2)
  progress      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: NoAction)
  manager       User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: NoAction)
  tasks         ProjectTask[]

  @@index([companyId, status])
  @@index([customerId])
}

model ProjectTask {
  id          String     @id @default(uuid())
  projectId   String
  assigneeId  String?
  parentId    String?
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Int        @default(2)
  startDate   DateTime?
  dueDate     DateTime?
  progress    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction)
  parent      ProjectTask? @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: NoAction)
  children    ProjectTask[] @relation("TaskHierarchy")

  @@index([projectId, status])
  @@index([assigneeId])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldValues  String?
  newValues  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction)

  @@index([companyId, createdAt])
  @@index([userId])
}
