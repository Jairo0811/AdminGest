generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Company {
  id             String          @id @default(uuid()) @db.NVarChar(36)
  name           String          @db.NVarChar(150)
  taxId          String?         @unique @db.NVarChar(30)
  email          String?         @db.NVarChar(254)
  phone          String?         @db.NVarChar(30)
  address        String?         @db.NVarChar(500)
  logoUrl        String?         @db.NVarChar(500)
  currency       String          @default("DOP") @db.NVarChar(3)
  timezone       String          @default("America/Santo_Domingo") @db.NVarChar(64)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  leads          Lead[]
  customers      Customer[]
  pipelineStages PipelineStage[]
  opportunities  Opportunity[]
  activities     Activity[]
  catalogItems   CatalogItem[]
  quotes         Quote[]
  projects       Project[]
  auditLogs      AuditLog[]
}

model User {
  id                    String        @id @default(uuid()) @db.NVarChar(36)
  companyId             String        @db.NVarChar(36)
  email                 String        @unique @db.NVarChar(254)
  passwordHash          String        @db.NVarChar(100)
  firstName             String        @db.NVarChar(60)
  lastName              String        @db.NVarChar(60)
  role                   String        @default("SALES_REP") @db.NVarChar(32)
  status                 String        @default("ACTIVE") @db.NVarChar(20)
  lastLoginAt            DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  company                Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedLeads          Lead[]        @relation("LeadOwner")
  assignedOpportunities Opportunity[] @relation("OpportunityOwner")
  assignedActivities    Activity[]    @relation("ActivityOwner")
  managedProjects       Project[]     @relation("ProjectManager")
  assignedTasks         ProjectTask[] @relation("TaskAssignee")
  auditLogs              AuditLog[]

  @@index([companyId, status])
  @@index([companyId, role])
}

model Lead {
  id          String   @id @default(uuid()) @db.NVarChar(36)
  companyId   String   @db.NVarChar(36)
  ownerId     String?  @db.NVarChar(36)
  firstName   String   @db.NVarChar(60)
  lastName    String?  @db.NVarChar(60)
  companyName String?  @db.NVarChar(150)
  jobTitle    String?  @db.NVarChar(100)
  email       String?  @db.NVarChar(254)
  phone       String?  @db.NVarChar(30)
  source      String?  @db.NVarChar(80)
  status      String   @default("NEW") @db.NVarChar(24)
  priority    Int      @default(2)
  notes       String?  @db.NVarChar(2000)
  convertedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner       User?    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status])
  @@index([ownerId])
}

model Customer {
  id            String        @id @default(uuid()) @db.NVarChar(36)
  companyId     String        @db.NVarChar(36)
  name          String        @db.NVarChar(150)
  taxId         String?       @db.NVarChar(30)
  email         String?       @db.NVarChar(254)
  phone         String?       @db.NVarChar(30)
  address       String?       @db.NVarChar(500)
  website       String?       @db.NVarChar(500)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]
  quotes        Quote[]
  projects      Project[]

  @@index([companyId, name])
  @@unique([companyId, taxId])
}

model Contact {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  customerId String   @db.NVarChar(36)
  firstName  String   @db.NVarChar(60)
  lastName   String?  @db.NVarChar(60)
  jobTitle   String?  @db.NVarChar(100)
  email      String?  @db.NVarChar(254)
  phone      String?  @db.NVarChar(30)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId])
}

model PipelineStage {
  id            String        @id @default(uuid()) @db.NVarChar(36)
  companyId     String        @db.NVarChar(36)
  name          String        @db.NVarChar(80)
  position      Int
  probability   Int           @default(0)
  isWon         Boolean       @default(false)
  isLost        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunities Opportunity[]

  @@unique([companyId, position])
  @@index([companyId])
}

model Opportunity {
  id                String        @id @default(uuid()) @db.NVarChar(36)
  companyId         String        @db.NVarChar(36)
  customerId        String        @db.NVarChar(36)
  ownerId           String?       @db.NVarChar(36)
  pipelineStageId   String        @db.NVarChar(36)
  name              String        @db.NVarChar(150)
  description       String?       @db.NVarChar(2000)
  estimatedValue    Decimal       @default(0) @db.Decimal(18, 2)
  probability       Int           @default(0)
  expectedCloseDate DateTime?
  status            String        @default("OPEN") @db.NVarChar(20)
  lostReason        String?       @db.NVarChar(500)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner             User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipelineStage     PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activities        Activity[]
  quotes            Quote[]
  project           Project?

  @@index([companyId, status])
  @@index([customerId])
  @@index([ownerId])
  @@index([pipelineStageId])
}

model Activity {
  id            String       @id @default(uuid()) @db.NVarChar(36)
  companyId     String       @db.NVarChar(36)
  customerId    String?      @db.NVarChar(36)
  opportunityId String?      @db.NVarChar(36)
  ownerId       String?      @db.NVarChar(36)
  type          String       @db.NVarChar(24)
  status        String       @default("PENDING") @db.NVarChar(20)
  subject       String       @db.NVarChar(150)
  description   String?      @db.NVarChar(2000)
  scheduledAt   DateTime
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer?    @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner         User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, scheduledAt])
  @@index([ownerId, status])
}

model CatalogItem {
  id          String      @id @default(uuid()) @db.NVarChar(36)
  companyId   String      @db.NVarChar(36)
  name        String      @db.NVarChar(150)
  description String?     @db.NVarChar(2000)
  type        String      @db.NVarChar(20)
  unitPrice   Decimal     @db.Decimal(18, 2)
  taxRate     Decimal     @default(18) @db.Decimal(5, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quoteItems  QuoteItem[]

  @@index([companyId, isActive])
}

model Quote {
  id            String       @id @default(uuid()) @db.NVarChar(36)
  companyId     String       @db.NVarChar(36)
  customerId    String       @db.NVarChar(36)
  opportunityId String?      @db.NVarChar(36)
  number        String       @db.NVarChar(30)
  status        String       @default("DRAFT") @db.NVarChar(20)
  issueDate     DateTime     @default(now())
  validUntil    DateTime?
  subtotal      Decimal      @default(0) @db.Decimal(18, 2)
  discount      Decimal      @default(0) @db.Decimal(18, 2)
  tax           Decimal      @default(0) @db.Decimal(18, 2)
  total         Decimal      @default(0) @db.Decimal(18, 2)
  notes         String?      @db.NVarChar(2000)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items         QuoteItem[]

  @@unique([companyId, number])
  @@index([customerId, status])
}

model QuoteItem {
  id            String       @id @default(uuid()) @db.NVarChar(36)
  quoteId       String       @db.NVarChar(36)
  catalogItemId String?      @db.NVarChar(36)
  description   String       @db.NVarChar(500)
  quantity      Decimal      @default(1) @db.Decimal(18, 2)
  unitPrice     Decimal      @db.Decimal(18, 2)
  taxRate       Decimal      @default(18) @db.Decimal(5, 2)
  lineTotal     Decimal      @db.Decimal(18, 2)
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([quoteId])
}

model Project {
  id            String        @id @default(uuid()) @db.NVarChar(36)
  companyId     String        @db.NVarChar(36)
  customerId    String        @db.NVarChar(36)
  opportunityId String?       @unique @db.NVarChar(36)
  managerId     String?       @db.NVarChar(36)
  name          String        @db.NVarChar(150)
  description   String?       @db.NVarChar(2000)
  status        String        @default("PLANNED") @db.NVarChar(20)
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?      @db.Decimal(18, 2)
  progress      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manager       User?         @relation("ProjectManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks         ProjectTask[]

  @@index([companyId, status])
  @@index([customerId])
}

model ProjectTask {
  id          String        @id @default(uuid()) @db.NVarChar(36)
  projectId   String        @db.NVarChar(36)
  assigneeId  String?       @db.NVarChar(36)
  parentId    String?       @db.NVarChar(36)
  title       String        @db.NVarChar(150)
  description String?       @db.NVarChar(2000)
  status      String        @default("PENDING") @db.NVarChar(20)
  priority    Int           @default(2)
  startDate   DateTime?
  dueDate     DateTime?
  progress    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignee    User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent      ProjectTask?  @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ProjectTask[] @relation("TaskHierarchy")

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([parentId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  companyId  String   @db.NVarChar(36)
  userId     String?  @db.NVarChar(36)
  action     String   @db.NVarChar(40)
  entity     String   @db.NVarChar(80)
  entityId   String?  @db.NVarChar(36)
  oldValues  String?  @db.NVarChar(4000)
  newValues  String?  @db.NVarChar(4000)
  ipAddress  String?  @db.NVarChar(64)
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt])
  @@index([userId])
}
