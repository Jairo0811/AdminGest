{
  "name": "admingest",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma modular de CRM, proyectos y gestión empresarial.",
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run db:validate && npm run lint && npm run test && npm run build",
    "security:audit": "npm audit --audit-level=critical",
    "release:check": "npm run db:generate && npm run verify && npm run security:audit",
    "db:generate": "npm run prisma:generate --workspace @admingest/api",
    "db:validate": "npm run prisma:validate --workspace @admingest/api",
    "db:migrate": "npm run prisma:migrate --workspace @admingest/api",
    "db:deploy": "npm run prisma:deploy --workspace @admingest/api",
    "db:seed": "npm run prisma:seed --workspace @admingest/api"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.3",
    "prettier": "^3.6.2"
  }
}
